# URL base de la API del backend Django.
#
# - PRODUCCION (build con `npm run build`): usar ruta RELATIVA "/api".
#   Nginx hace proxy inverso de /api/ hacia Gunicorn en 127.0.0.1:8000,
#   asi no hay CORS ni dependency del hostname/IP del servidor.
#
# - DESARROLLO (vite dev en :5173): usar URL ABSOLUTA del backend,
#   porque en desarrollo no pasa por Nginx y si hace falta CORS.
VITE_API_URL=/api
