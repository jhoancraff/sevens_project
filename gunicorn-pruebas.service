[Unit]
Description=Gunicorn del entorno de PRUEBAS (base sevensdb_test, puerto 8001)
Documentation=file:/home/sevens/sevens_project/README.md

# Aplica lo mismo que el de produccion: esperar la red de verdad, la base
# de datos lista antes de abrir conexiones, y no quedarse reintentando
# para siempre si la base tardó.
Wants=network-online.target
After=network-online.target
Requires=postgresql.service
After=postgresql.service

StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=sevens
Group=sevens
WorkingDirectory=/home/sevens/sevens_project/backend
EnvironmentFile=/home/sevens/sevens_project/backend/.env

# Lo que distingue esta instancia de la de produccion: la base de datos y
# el nombre del entorno, que la app lee para pintar el aviso en pantalla.
# Environment= se aplica DESPUES de EnvironmentFile=, asi que gana sobre el
# DB_NAME que este tenga.
Environment=DB_NAME=sevensdb_test
Environment=SEVENS_AMBIENTE=pruebas

# Puerto propio (8001) para no chocar con produccion (8000).
ExecStart=/home/sevens/sevens_project/backend/venv/bin/gunicorn --bind 127.0.0.1:8001 --workers 2 --timeout 60 --access-logfile - --error-logfile - core.wsgi:application

Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gunicorn-pruebas

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
