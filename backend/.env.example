# Django Configuration Template (Copy to .env and adjust)
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=sevensdb
DB_USER=sevens
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alerta diaria de stock minimo por Telegram (ver sevens/alertas_stock.py)
# Token del bot (@BotFather) y chats que reciben el aviso, separados por coma.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Hora (0-23, hora de Venezuela) a partir de la cual sale el aviso del dia. Por defecto 8.
TELEGRAM_ALERTA_STOCK_HORA=8
